# AttentionOS secrets for this workspace.
# Copy this file to .env and fill in only what your setup level needs.
# .env is gitignored: never commit it, never paste its contents into a chat.
# `./aos doctor` tells you which ones are missing and how to get each.

# --- Level 1: research and scripts ---------------------------------------------

# Your local database (Postgres with pgvector). Inside the Docker stack this is set for you. Running from source
# against `pnpm db:start` or your own pgvector Postgres, it looks like:
# postgresql://attentionos:your-password@127.0.0.1:5432/attentionos
DATABASE_URL=

# Apify token for competitor research (apify.com > Settings > Integrations). Free plan works to start.
APIFY_TOKEN=

# Instagram Graph API long-lived token, an alternative or backup to Apify for your own account and competitors.
IG_ACCESS_TOKEN=

# Your Instagram business account id, used with IG_ACCESS_TOKEN.
IG_USER_ID=

# Telegram bot token from @BotFather, for the morning brief and approve or reject buttons.
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id with the bot (`./aos doctor` can find it after you message the bot once).
TELEGRAM_CHAT_ID=

# --- Level 2: editing ----------------------------------------------------------

# Optional. Which whisper.cpp model to use for transcripts, for example base.en or small.en. Leave empty for the default.
# ATTENTIONOS_ASR_MODEL=

# Optional. OpenAI key, only if you set knowledge: { embeddings: "openai" }.
OPENAI_API_KEY=

# Optional. Voyage AI key, only if you set knowledge: { embeddings: "voyage" }. Local embeddings need no key.
VOYAGE_API_KEY=

# --- Level 3: publish and engage -----------------------------------------------

# Zernio API key, the default for publishing, DMs and analytics (first 2 accounts are free).
ZERNIO_API_KEY=

# Optional. Zernio webhook signing secret, so post updates and DMs arrive instantly instead of by polling.
# ZERNIO_WEBHOOK_SECRET=

# Optional. Limit this workspace to one Zernio profile (one brand), for example with a profile-scoped key.
# ZERNIO_PROFILE_ID=

# Blotato API key, only if you publish with Blotato instead of Zernio.
BLOTATO_API_KEY=

# Optional, Blotato only. The public URL of your worker's /webhooks/blotato, and a long random string Blotato sends
# with each automation webhook. Together they turn on lead capture.
# BLOTATO_WEBHOOK_URL=
# BLOTATO_WEBHOOK_SECRET=

# Optional. Where new leads are sent (your CRM, Zapier, Make or n8n webhook URL), for crm: "webhook".
CRM_WEBHOOK_URL=

# Optional. Signs each lead sent to CRM_WEBHOOK_URL, so your endpoint can check it came from you.
# CRM_WEBHOOK_SECRET=

# Optional, crm: "sheets". Your Google Sheets Apps Script web app URL and the secret it checks.
# SHEETS_WEBHOOK_URL=
# SHEETS_WEBHOOK_SECRET=

# Optional, crm: "gohighlevel". A private integration token and the location (sub-account) id.
# GHL_PRIVATE_TOKEN=
# GHL_LOCATION_ID=

# Optional, crm: "hubspot". A private app access token with contacts scope.
# HUBSPOT_ACCESS_TOKEN=

# Optional. Shared secret for webhooks from services without their own signature check (sent as the
# x-attentionos-secret header). Without it, the worker turns those webhooks away.
# ATTENTIONOS_WEBHOOK_SECRET=

# Optional. Discord instead of Telegram: bot token, the channel for messages, your user id, and the app public key.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
DISCORD_PUBLIC_KEY=

# --- Optional: the API engine ---------------------------------------------------

# Optional. Anthropic API key, only if you set runner: { engine: "api" } in config/attentionos.config.ts.
# By default your agents (including the background worker) run on your own signed-in Claude Code and Claude plan,
# so you can leave this empty. On a server, sign Claude Code in with `claude setup-token` instead (see the VPS guide).
ANTHROPIC_API_KEY=
