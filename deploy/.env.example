# Settings for the AttentionOS stack (docker-compose.yml). Copy to <stack dir>/.env and chmod 600 it.
# Treat it like a password file and never commit it. Walkthrough: docs/install.md

# The database password. Made up once at install; the database is never reachable from outside the stack.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Your own Claude login, made once with `claude setup-token` on a computer with a browser (starts with sk-ant-oat01-).
# Your agents use it to run on your Claude plan. Leave empty to sign in later: ./aos claude-login
CLAUDE_CODE_OAUTH_TOKEN=

# Studio's access key (at least 24 random characters). Required when Studio asks for sign-in (AOS_STUDIO_AUTH=token).
ATTENTIONOS_STUDIO_TOKEN=change-me-to-at-least-24-random-characters

# Your workspace folder on this computer (Brand Kit, settings, lessons, media). Created on the first start.
WORKSPACE_DIR=./workspace

# Starting point for a new workspace: coach-consultant or agency-founder.
PRESET=coach-consultant
# Your brand's name for a new workspace (you can change it in Studio).
BRAND_NAME=My Brand

# Your timezone (IANA name), for schedules and the morning brief.
TZ=America/New_York

# Advanced
# Port for Studio on this computer (published to 127.0.0.1 only).
# AOS_STUDIO_AUTH=token makes Studio ask for the access key; set it if you proxy Studio to other devices.
AOS_PORT=4747
# Compose project name, image tag and the repo checkout the image is built from.
AOS_PROJECT=attentionos
AOS_IMAGE=attentionos:local
AOS_SRC_DIR=..
# Where `./aos update` fetches new versions from.
AOS_REPO_URL=https://github.com/evanbaker315/AttentionOS
AOS_REPO_BRANCH=main
# This folder's full path on the host. Lets Claude Code on your computer reach your data (the workspace's .mcp.json).
AOS_STACK_DIR=
