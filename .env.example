# Environment for developing the AttentionOS engine in this repo.
# Copy to .env and fill in only what you need. Never commit .env.
# (Users' workspaces get their own .env.example from templates/workspace/.)

# --- Database --------------------------------------------------------------
# Local Postgres with pgvector: `pnpm db:start` (Docker, 127.0.0.1:55433), or any Postgres 16+ with pgvector.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/postgres
# Postgres SERVER for tests: each suite creates and drops its own attentionos_test_* database on it (never the one named here).
ATTENTIONOS_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/postgres

# --- Engine ----------------------------------------------------------------
# debug | info | warn | error
ATTENTIONOS_LOG_LEVEL=info
# Path to a PRIVATE deny-list for the brand-literal guard (kept outside the repo).
ATTENTIONOS_DENYLIST=

# --- Claude: optional, only for runner.engine "api" ------------------------
# By default agents run on your own signed-in Claude Code; no key needed.
ANTHROPIC_API_KEY=

# --- Publishing, inbox and analytics ---------------------------------------
ZERNIO_API_KEY=
BLOTATO_API_KEY=

# --- Research --------------------------------------------------------------
APIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- Notifications and chat ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
DISCORD_PUBLIC_KEY=

# --- CRM -------------------------------------------------------------------
CRM_WEBHOOK_URL=

# --- Images (opt-in) -------------------------------------------------------
OPENAI_API_KEY=
